#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""任务 2 的测试程序：自动读取 inputs/，与 outputs/ 中的同名文件逐行比对。

用法：
    python test                     # 等价于 make test（默认跑数组栈样例）
    python test --exe build/task2 --inputs inputs --outputs outputs
    python test --inputs linked_inputs --outputs linked_outputs --arg=--linked

比对规则：
  - 逐行比较，行尾空白与文件末尾空行不计；
  - 以 "PERF " 开头的行（性能统计，耗时每次不同）比较时忽略；
  - 程序退出码非 0 视为 FAIL，并打印 stderr 摘要。

跨平台：
  - resolve_exe() 在 Windows 上补 .exe 后缀并转绝对路径
    （MinGW 的 g++ -o build/task1 实际生成 build/task1.exe；
     且 Windows 上 subprocess 传裸相对路径会抛 WinError 2）；
  - 所有文件读写显式 encoding="utf-8"；
  - main() 开头把 stdout 重配置成 utf-8，避免 Windows 控制台
    用 GBK/cp1252 编码打印中文标点时报 UnicodeEncodeError。

退出码：全部 PASS 为 0，否则为 1。
"""

import argparse
import os
import subprocess
import sys

PERF_PREFIX = "PERF "
HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_EXE = os.path.join("build", os.path.basename(HERE))


def resolve_exe(path):
    """补上 Windows 下缺失的 .exe 后缀，并转成绝对路径。

    MinGW 的 g++ 会把 -o build/task1 编译成 build/task1.exe；且 Windows 上
    subprocess 传裸相对路径会抛 WinError 2，必须传绝对路径。Linux 上 .exe
    后缀为空、abspath 无副作用，行为不变。
    """
    if os.name == "nt" and not path.lower().endswith(".exe"):
        path += ".exe"
    return os.path.abspath(path)


def normalize(text):
    lines = []
    for raw in text.splitlines():
        line = raw.rstrip()
        if line.startswith(PERF_PREFIX):
            continue
        lines.append(line)
    while lines and lines[-1] == "":
        lines.pop()
    return lines


def first_difference(expected, actual):
    for i in range(max(len(expected), len(actual))):
        want = expected[i] if i < len(expected) else "<没有这一行>"
        got = actual[i] if i < len(actual) else "<没有这一行>"
        if want != got:
            return i + 1, want, got
    return None


def run_case(exe, input_path, expected_path, extra_args=()):
    with open(input_path, encoding="utf-8") as f:
        stdin_data = f.read()
    proc = subprocess.run([exe, *extra_args], input=stdin_data, capture_output=True,
                          text=True, encoding="utf-8")

    with open(expected_path, encoding="utf-8") as f:
        expected = normalize(f.read())
    actual = normalize(proc.stdout)

    if proc.returncode != 0:
        detail = proc.stderr.strip().splitlines()[:3]
        return False, f"退出码 {proc.returncode}" + (
            f"; stderr: {' | '.join(detail)}" if detail else "")
    diff = first_difference(expected, actual)
    if diff is not None:
        line_no, want, got = diff
        return False, f"第 {line_no} 行不同: 期望 [{want}] 实际 [{got}]"
    return True, f"{len(expected)} 行一致"


def main():
    sys.stdout.reconfigure(encoding="utf-8")
    parser = argparse.ArgumentParser(description="样例自动比对")
    parser.add_argument("--exe", default=DEFAULT_EXE, help="被测程序")
    parser.add_argument("--inputs", default="inputs", help="输入样例目录")
    parser.add_argument("--outputs", default="outputs", help="期望输出目录")
    parser.add_argument("--arg", action="append", default=[], metavar="ARG",
                        help="传给被测程序的额外参数（如 --linked）")
    args = parser.parse_args()

    os.chdir(HERE)
    args.exe = resolve_exe(args.exe)

    if not os.path.isfile(args.exe):
        print(f"找不到程序 {args.exe}，请先运行 make")
        return 1
    if not os.path.isdir(args.inputs):
        print(f"找不到输入目录 {args.inputs}")
        return 1

    cases = sorted(n for n in os.listdir(args.inputs) if n.endswith(".txt"))
    if not cases:
        print(f"{args.inputs}/ 下没有样例")
        return 1

    failures = []
    print(f"{'结果':<6}{'样例':<20}说明")
    print("-" * 60)

    for name in cases:
        expected_path = os.path.join(args.outputs, name)
        if not os.path.isfile(expected_path):
            failures.append((name, f"找不到期望输出 {expected_path}"))
            print(f"{'FAIL':<6}{name:<20}找不到期望输出")
            continue

        ok, detail = run_case(args.exe, os.path.join(args.inputs, name),
                              expected_path, args.arg)
        if ok:
            print(f"{'PASS':<6}{name:<20}{detail}")
        else:
            failures.append((name, detail))
            print(f"{'FAIL':<6}{name:<20}{detail}")

    print("-" * 60)
    total = len(cases)
    passed = total - len(failures)
    print(f"汇总: {passed}/{total} PASS, {len(failures)} FAIL")

    if failures:
        print("\n失败明细:")
        for name, detail in failures:
            print(f"  {name}: {detail}")
        return 1
    print("全部通过")
    return 0


if __name__ == "__main__":
    sys.exit(main())