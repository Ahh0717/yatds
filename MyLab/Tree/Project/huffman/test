#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""huffman 任务的测试程序：样例统计比对 + 往返 + 确定性 + 文件头 + 坏文件。

用法：
    make test                                       # 推荐
    python test                                     # 等价，用默认路径
    python test --exe build/huffman --inputs inputs --outputs outputs

检查项：
  1. 逐个跑 stats，与 outputs/ 同名文件逐行比对（忽略行尾空白与末尾空行）；
  2. 压缩到 build/tmp 下的临时文件，再解压，与原文件逐字节比较；
  3. 同一输入压缩两次，确认两份输出完全一致（确定性）；
  4. 压缩文件前 4 字节是 SDF1，offset 4 的 u32 等于原文件大小；
  5. case07 的压缩结果必须小于原始大小；
  6. 坏魔数与截断文件必须让 decompress 退出码非 0，stderr 含 ERROR；
  7. 固定种子的 24 组随机数据（含二进制、小字母表、周期串）往返一致、两次压缩相同。

跨平台：
  - Windows 上补 .exe 后缀并转绝对路径（MinGW 的 g++ -o build/huffman
    实际生成 build/huffman.exe；subprocess 传裸相对路径会抛 WinError 2）；
  - stdout 重配置为 utf-8，文本读写显式 encoding="utf-8"；
  - 压缩文件按二进制读写，不经过文本编码；
  - 临时文件统一放 build/tmp，结束时删除，不留残留。

退出码：全部 PASS 返回 0，否则返回 1。
"""

import argparse
import os
import random
import shutil
import struct
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_EXE = os.path.join("build", "huffman")
TMP_DIR = os.path.join("build", "tmp")


def resolve_exe(path):
    """Windows 下补 .exe 后缀，并转成绝对路径；其他平台只做 abspath。"""
    if os.name == "nt" and not path.lower().endswith(".exe"):
        path += ".exe"
    return os.path.abspath(path)


def normalize(text):
    """按行拆分、去掉行尾空白、丢弃文件末尾的空行。"""
    lines = [raw.rstrip() for raw in text.splitlines()]
    while lines and lines[-1] == "":
        lines.pop()
    return lines


def first_difference(expected, actual):
    for i in range(max(len(expected), len(actual))):
        want = expected[i] if i < len(expected) else "<没有这一行>"
        got = actual[i] if i < len(actual) else "<没有这一行>"
        if want != got:
            return i + 1, want, got
    return None


def run_bin(exe, args):
    """二进制模式跑子进程，stdout/stderr 为 bytes。"""
    return subprocess.run([exe] + args, capture_output=True)


def run_text(exe, args):
    """文本模式跑子进程，stdout/stderr 按 utf-8 解码。"""
    return subprocess.run([exe] + args, capture_output=True, text=True,
                          encoding="utf-8")


def check_stats(exe, name, input_path, expected_path, problems):
    """stats 输出与 outputs/ 同名文件逐行比对。"""
    if not os.path.isfile(expected_path):
        problems.append(f"缺少期望输出 {expected_path}")
        return

    proc = run_text(exe, ["stats", input_path])
    if proc.returncode != 0:
        detail = proc.stderr.strip().splitlines()
        shown = detail[0] if detail else "无 stderr 输出"
        problems.append(f"stats 退出码 {proc.returncode}: {shown}")
        return

    with open(expected_path, encoding="utf-8") as f:
        expected = normalize(f.read())
    actual = normalize(proc.stdout)

    diff = first_difference(expected, actual)
    if diff is not None:
        line_no, want, got = diff
        problems.append(f"stats 第 {line_no} 行不同: 期望 [{want}] 实际 [{got}]")


def check_case(exe, name, inputs_dir, outputs_dir, tmp_dir):
    """返回 (问题列表, 压缩前后大小)。问题列表为空表示通过。"""
    problems = []
    input_path = os.path.join(inputs_dir, name)
    expected_path = os.path.join(outputs_dir, name)

    with open(input_path, "rb") as f:
        original = f.read()

    # 1. stats 与期望输出比对。
    check_stats(exe, name, input_path, expected_path, problems)

    # 2. 压缩两次，验证确定性。
    packed1 = os.path.join(tmp_dir, name + ".1.bin")
    packed2 = os.path.join(tmp_dir, name + ".2.bin")
    for packed in (packed1, packed2):
        proc = run_bin(exe, ["compress", input_path, packed])
        if proc.returncode != 0:
            detail = proc.stderr.decode("utf-8", "replace").strip()
            problems.append(f"compress 退出码 {proc.returncode}: {detail[:120]}")
            return problems, None

    with open(packed1, "rb") as f:
        first = f.read()
    with open(packed2, "rb") as f:
        second = f.read()
    if first != second:
        problems.append("两次压缩结果不同（确定性失败）")

    # 3. 文件头：魔数 + 原始长度。
    if len(first) < 10:
        problems.append(f"压缩文件只有 {len(first)} 字节，不够文件头")
    else:
        if first[:4] != b"SDF1":
            problems.append(f"前 4 字节不是 SDF1: {first[:4]!r}")
        original_length = struct.unpack_from("<I", first, 4)[0]
        if original_length != len(original):
            problems.append(
                f"文件头原始长度 {original_length} != 实际 {len(original)}")

    # 4. 解压回临时文件，逐字节比较。
    restored = os.path.join(tmp_dir, name + ".out")
    proc = run_bin(exe, ["decompress", packed1, restored])
    if proc.returncode != 0:
        detail = proc.stderr.decode("utf-8", "replace").strip()
        problems.append(f"decompress 退出码 {proc.returncode}: {detail[:120]}")
    else:
        with open(restored, "rb") as f:
            recovered = f.read()
        if recovered != original:
            problems.append(
                f"解压结果与原文件不一致（{len(recovered)} vs {len(original)} 字节）")

    # 5. case07：压缩后必须比原文小。
    if name == "case07.txt" and not (len(first) < len(original)):
        problems.append(
            f"case07 压缩后 {len(first)} 字节，未小于原文 {len(original)} 字节")

    return problems, (len(original), len(first))


def check_bad_files(exe, sample_packed, tmp_dir):
    """坏魔数 / 截断文件必须报错退出，且不留下输出文件。"""
    problems = []
    with open(sample_packed, "rb") as f:
        valid = f.read()

    bad_magic = bytearray(valid)
    bad_magic[0] = ord("X")
    truncated = valid[:max(1, len(valid) // 2)]

    cases = [
        ("bad_magic.bad", bytes(bad_magic), "坏魔数"),
        ("truncated.bad", truncated, "截断文件"),
    ]
    for filename, blob, label in cases:
        path = os.path.join(tmp_dir, filename)
        out = os.path.join(tmp_dir, filename + ".out")
        with open(path, "wb") as f:
            f.write(blob)

        proc = run_bin(exe, ["decompress", path, out])
        if proc.returncode == 0:
            problems.append(f"{label}: 退出码为 0，应为非 0")
        stderr = proc.stderr.decode("utf-8", "replace")
        if "ERROR" not in stderr:
            problems.append(f"{label}: stderr 里没有 ERROR（实际 {stderr.strip()[:80]!r}）")
        if os.path.exists(out):
            problems.append(f"{label}: 失败后仍留下了输出文件")
    return problems


def check_random_roundtrip(exe, tmp_dir):
    """固定种子的随机数据：两次压缩逐字节相同，解压后与原数据一致。

    覆盖纯二进制、小字母表、周期串三类；种子固定，结果可复现。
    """
    problems = []
    rng = random.Random(24325083)
    alphabets = [bytes(range(256)), b"abc", b"ab", b"\x00\x01\x02\x03"]

    for index in range(24):
        length = rng.randrange(0, 401)
        alphabet = alphabets[index % len(alphabets)]
        if index >= 16:
            # 周期串：制造长距离、长长度的匹配。
            base = bytes(rng.choice(alphabet)
                         for _ in range(rng.randrange(1, 33)))
            data = (base * (length // len(base) + 1))[:length]
        else:
            data = bytes(rng.choice(alphabet) for _ in range(length))

        src = os.path.join(tmp_dir, f"random{index:02d}.in")
        packed1 = src + ".1.bin"
        packed2 = src + ".2.bin"
        restored = src + ".out"
        with open(src, "wb") as f:
            f.write(data)

        for packed in (packed1, packed2):
            proc = run_bin(exe, ["compress", src, packed])
            if proc.returncode != 0:
                detail = proc.stderr.decode("utf-8", "replace").strip()
                problems.append(f"随机第 {index} 组 compress 失败: {detail[:100]}")
                return problems

        with open(packed1, "rb") as f:
            first = f.read()
        with open(packed2, "rb") as f:
            second = f.read()
        if first != second:
            problems.append(f"随机第 {index} 组两次压缩结果不同")
            return problems
        if len(first) < 10 or first[:4] != b"SDF1":
            problems.append(f"随机第 {index} 组文件头魔数不对")
            return problems
        if struct.unpack_from("<I", first, 4)[0] != len(data):
            problems.append(f"随机第 {index} 组文件头原始长度不对")
            return problems

        proc = run_bin(exe, ["decompress", packed1, restored])
        if proc.returncode != 0:
            detail = proc.stderr.decode("utf-8", "replace").strip()
            problems.append(f"随机第 {index} 组 decompress 失败: {detail[:100]}")
            return problems
        with open(restored, "rb") as f:
            recovered = f.read()
        if recovered != data:
            problems.append(
                f"随机第 {index} 组往返不一致（{len(data)} vs {len(recovered)} 字节）")
            return problems

    return problems


def main():
    sys.stdout.reconfigure(encoding="utf-8")
    parser = argparse.ArgumentParser(description="huffman 样例自动比对")
    parser.add_argument("--exe", default=DEFAULT_EXE, help="被测程序")
    parser.add_argument("--inputs", default="inputs", help="输入样例目录")
    parser.add_argument("--outputs", default="outputs", help="期望输出目录")
    args = parser.parse_args()

    os.chdir(HERE)
    exe = resolve_exe(args.exe)

    if not os.path.isfile(exe):
        print(f"找不到程序 {exe}，请先运行 make")
        return 1
    if not os.path.isdir(args.inputs):
        print(f"找不到输入目录 {args.inputs}")
        return 1
    if not os.path.isdir(args.outputs):
        print(f"找不到期望输出目录 {args.outputs}")
        return 1

    cases = sorted(name for name in os.listdir(args.inputs)
                   if name.endswith(".txt"))
    if not cases:
        print(f"{args.inputs}/ 下没有样例")
        return 1

    if os.path.isdir(TMP_DIR):
        shutil.rmtree(TMP_DIR, ignore_errors=True)
    os.makedirs(TMP_DIR)

    failures = []
    rows = []

    try:
        for name in cases:
            problems, sizes = check_case(exe, name, args.inputs, args.outputs,
                                         TMP_DIR)
            if problems:
                failures.append((name, problems))
                rows.append((name, "FAIL", problems[0]))
            else:
                note = f"{sizes[0]} -> {sizes[1]} 字节" if sizes else ""
                rows.append((name, "PASS", note))

        # 坏文件检查：用第一个样例的压缩结果改造。
        sample = os.path.join(TMP_DIR, cases[0] + ".1.bin")
        bad_problems = check_bad_files(exe, sample, TMP_DIR)
        if bad_problems:
            failures.append(("坏文件", bad_problems))
            rows.append(("坏文件", "FAIL", bad_problems[0]))
        else:
            rows.append(("坏文件", "PASS", "坏魔数与截断文件均按预期报错"))

        # 随机数据：不作为样例比对，只验证往返与确定性。
        random_problems = check_random_roundtrip(exe, TMP_DIR)
        if random_problems:
            failures.append(("随机往返", random_problems))
            rows.append(("随机往返", "FAIL", random_problems[0]))
        else:
            rows.append(("随机往返", "PASS", "24 组随机数据往返与确定性检查通过"))
    finally:
        shutil.rmtree(TMP_DIR, ignore_errors=True)

    print(f"{'结果':<6}{'样例':<16}说明")
    print("-" * 64)
    for name, status, note in rows:
        print(f"{status:<6}{name:<16}{note}")

    print("-" * 64)
    total = len(rows)
    passed = total - len(failures)
    print(f"汇总: {passed}/{total} PASS, {len(failures)} FAIL")

    if os.path.isdir(TMP_DIR):
        print(f"  临时目录未清理: {TMP_DIR}")
        failures.append(("build/tmp", ["临时目录未清理"]))
        passed = total - len(failures)

    if failures:
        print("\n失败明细:")
        for name, problems in failures:
            for problem in problems:
                print(f"  {name}: {problem}")
        return 1

    print("全部通过")
    return 0


if __name__ == "__main__":
    sys.exit(main())